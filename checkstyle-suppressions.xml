<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- PERMANENT — by design, each with its reason -->
    <!-- Main code: plain camelCase method names; tests: methodName_whenCondition_expectedResult -->
    <suppress id="methodNameTest" files="[\\/]src[\\/]main[\\/]"/>
    <suppress id="methodNameMain" files="[\\/]src[\\/]test[\\/]"/>
    <!-- ArchUnit's own convention names rule fields in lower_snake_case -->
    <suppress checks="ConstantName" files="[\\/]architecture[\\/]ArchitectureTest\.java$"/>

    <!-- BASELINE START — legacy violations recorded 2026-09-23 (W-045a). May only shrink (now 0). -->
    <!-- BASELINE END -->
</suppressions>
